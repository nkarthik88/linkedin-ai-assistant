{
  "manifest_version": 3,
  "name": "ProPostly",
  "version": "1.4.0",
  "description": "AI-powered LinkedIn content + lead generation: posts, DMs, comment replies, headlines, viral rewrites, and a Find Leads CRM.",
  "homepage_url": "https://www.propostly.com",
  "permissions": ["storage", "activeTab", "tabs", "scripting", "sidePanel"],
  "side_panel": {
    "default_path": "sidePanel.html"
  },
  "host_permissions": [
    "*://*.linkedin.com/*",
    "https://api.propostly.com/*"
  ],
  "action": {
    "default_icon": "icons/icon48.png",
    "default_title": "Open ProPostly"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.linkedin.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
