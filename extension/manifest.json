{
  "manifest_version": 3,
  "name": "ProPostly",
  "version": "1.1.1",
  "description": "AI-powered LinkedIn post generation, DMs, comment replies, headlines, and viral rewrites.",
  "homepage_url": "https://www.propostly.com",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": [
    "*://*.linkedin.com/*",
    "https://linkedin-ai-backend-rho.vercel.app/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icons/icon48.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.linkedin.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
